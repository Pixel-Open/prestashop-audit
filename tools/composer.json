{
  "name": "pixel-open/audit-tools",
  "description": "Standalone development tools for Pixel Audit",
  "license": "MIT",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.64"
  },
  "autoload": {
    "psr-4": {
      "Pixel\\Module\\Audit\\": "../src/"
    }
  },
  "scripts": {
    "test": "phpunit -c ../phpunit.xml.dist",
    "analyse": "phpstan analyse -c ../phpstan.neon.dist --no-progress",
    "style": "php-cs-fixer fix --config=../.php-cs-fixer.dist.php --dry-run --diff",
    "style:fix": "php-cs-fixer fix --config=../.php-cs-fixer.dist.php",
    "check": [
      "@test",
      "@analyse",
      "@style",
      "php ../tools/check-release.php"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": false,
    "platform": {
      "php": "8.1.0"
    }
  }
}
