<script type="application/json" id="pixel-audit-translations">{$audit_translations_json nofilter}</script>
<div class="panel pixel-audit-ui">
  <header class="pixel-audit-heading"><div><h3 class="pixel-audit-title">{if $audit_filters.type == 'employee_login'}{l s='Back-office logins' d='Modules.Pixelaudit.Admin'}{else}{l s='Audit log' d='Modules.Pixelaudit.Admin'}{/if}</h3><p class="pixel-audit-muted">{if $audit_filters.type == 'employee_login'}{l s='Review successful back-office logins, including the employee, date and IP address.' d='Modules.Pixelaudit.Admin'}{else}{l s='Find who changed what, compare values and review product history.' d='Modules.Pixelaudit.Admin'}{/if}</p></div><span class="pixel-audit-badge"><i class="material-icons" aria-hidden="true">schedule</i>{l s='Dates in UTC' d='Modules.Pixelaudit.Admin'}</span></header>
  <nav class="pixel-audit-navigation" aria-label="{l s='Audit navigation' d='Modules.Pixelaudit.Admin'}"><a href="{$audit_url|escape:'html':'UTF-8'}" {if $audit_filters.type != 'employee_login'}aria-current="page"{/if}><i class="material-icons" aria-hidden="true">history</i>{l s='Audit log' d='Modules.Pixelaudit.Admin'}</a><a href="{$audit_url|escape:'html':'UTF-8'}&amp;audit_type=employee_login" {if $audit_filters.type == 'employee_login'}aria-current="page"{/if}><i class="material-icons" aria-hidden="true">login</i>{l s='Back-office logins' d='Modules.Pixelaudit.Admin'}</a><a href="{$audit_settings_url|escape:'html':'UTF-8'}"><i class="material-icons" aria-hidden="true">settings</i>{l s='Configuration' d='Modules.Pixelaudit.Admin'}</a><a href="{$audit_about_url|escape:'html':'UTF-8'}"><i class="material-icons" aria-hidden="true">info</i>{l s='About' d='Modules.Pixelaudit.Admin'}</a><a href="{$audit_diagnostics_url|escape:'html':'UTF-8'}"><i class="material-icons" aria-hidden="true">monitor_heart</i>{l s='Diagnostics' d='Modules.Pixelaudit.Admin'}</a></nav>
  {if $audit_viewing}
    <div class="pixel-audit-section-heading"><div><a class="btn btn-default pixel-audit-back" href="{$audit_back_url|escape:'html':'UTF-8'}"><i class="material-icons" aria-hidden="true">arrow_back</i>{l s='Back to audit log' d='Modules.Pixelaudit.Admin'}</a><h4>{l s='Operation #' d='Modules.Pixelaudit.Admin'}{$audit_operation_id|intval}</h4></div><span class="pixel-audit-badge">{$audit_details|count} {l s='event(s)' d='Modules.Pixelaudit.Admin'}</span></div>
    {if !$audit_details}<div class="alert alert-warning">{l s='Operation not found, expired or unavailable in this shop context.' d='Modules.Pixelaudit.Admin'}</div>{/if}
    <div class="pixel-audit-events" data-audit-journal-restoration>
      {foreach $audit_details as $event}
      <section class="pixel-audit-event" data-audit-journal-event>
        <header class="pixel-audit-event-heading"><div><h4>{if $event.root_display != $event.subject_display}{$event.root_display|escape:'html':'UTF-8'} <span aria-hidden="true">/</span> {/if}{$event.subject_display|escape:'html':'UTF-8'}</h4><p class="pixel-audit-muted">{$event.date_add|escape:'html':'UTF-8'} UTC · {$event.actor_name|escape:'html':'UTF-8'} (#{$event.actor_id|intval})</p></div><span class="pixel-audit-badge pixel-audit-action-{$event.action|escape:'html':'UTF-8'}">{$event.action_display|escape:'html':'UTF-8'}</span></header>
        <div class="pixel-audit-event-meta"><span class="pixel-audit-badge">{$audit_families[$event.family]|default:$event.family|escape:'html':'UTF-8'}</span><span>{l s='Shop' d='Modules.Pixelaudit.Admin'} #{$event.id_shop|intval}</span><span>{include file='./origin.tpl' audit_origin=$event.origin}</span></div>
        {if !empty($event.object_url)}<p><a class="btn btn-default" href="{$event.object_url|escape:'html':'UTF-8'}" target="_blank" rel="noopener noreferrer"><i class="material-icons" aria-hidden="true">open_in_new</i>{l s='Open object' d='Modules.Pixelaudit.Admin'}</a></p>{/if}
        {if !empty($event.source_operation_id)}<p class="pixel-audit-linked">{l s='Restoration of operation #' d='Modules.Pixelaudit.Admin'}{$event.source_operation_id|intval} {l s='(event #' d='Modules.Pixelaudit.Admin'}{$event.source_event_id|intval}).</p>{/if}
        {if $event.observation == 'partial'}<div class="alert alert-warning">{l s='Changes observed during an interrupted request.' d='Modules.Pixelaudit.Admin'}</div>{/if}
        {include file='./event-changes.tpl' audit_allow_restore=$event.restore_allowed audit_product=$event.root_id}
      </section>
      {/foreach}
    </div>
    {if !empty($audit_restore_script)}<script defer src="{$audit_restore_script|escape:'html':'UTF-8'}"></script>{/if}
  {else}
    <div class="pixel-audit-overview"><div><span class="pixel-audit-muted">{l s='Matching operations' d='Modules.Pixelaudit.Admin'}</span><strong>{$audit_result.count|intval}</strong></div><div><span class="pixel-audit-muted">{l s='On this page' d='Modules.Pixelaudit.Admin'}</span><strong>{$audit_result.rows|count}</strong></div><p>{l s='Results follow your filters, retention policy and shop permissions.' d='Modules.Pixelaudit.Admin'}</p></div>
    {include file='./journal-filters.tpl'}
    <div class="pixel-audit-operation-list">
      {foreach $audit_result.rows as $row}
      <article class="pixel-audit-journal-operation">
        <div class="pixel-audit-operation-identity"><span class="pixel-audit-operation-icon"><i class="material-icons" aria-hidden="true">history</i></span><div><a class="pixel-audit-operation-link" href="{$audit_back_url|escape:'html':'UTF-8'}&amp;operation_id={$row.id_operation|intval}">{l s='Operation #' d='Modules.Pixelaudit.Admin'}{$row.id_operation|intval}</a><span class="pixel-audit-muted">{$row.date_add|escape:'html':'UTF-8'} UTC</span></div></div>
        <div class="pixel-audit-operation-subjects"><strong>{$row.subjects_display|escape:'html':'UTF-8'}</strong><span class="pixel-audit-muted">{$row.actor_name|escape:'html':'UTF-8'} (#{$row.actor_id|intval}) <span aria-hidden="true">/</span> {include file='./origin.tpl' audit_origin=$row.origin}</span></div>
        <a class="btn btn-default" href="{$audit_back_url|escape:'html':'UTF-8'}&amp;operation_id={$row.id_operation|intval}">{l s='Details' d='Modules.Pixelaudit.Admin'}<i class="material-icons" aria-hidden="true">arrow_forward</i></a>
      </article>
      {foreachelse}<div class="pixel-audit-empty"><i class="material-icons" aria-hidden="true">history</i><h4>{l s='No changes recorded.' d='Modules.Pixelaudit.Admin'}</h4><p>{l s='Try another filter or check which families are collected.' d='Modules.Pixelaudit.Admin'}</p></div>{/foreach}
    </div>
    <nav class="pixel-audit-pagination" aria-label="{l s='History pagination' d='Modules.Pixelaudit.Admin'}"><span class="pixel-audit-muted">{l s='Page' d='Modules.Pixelaudit.Admin'} {$audit_page|intval}</span><div>{if $audit_page > 1}<a class="btn btn-default" href="{$audit_previous|escape:'html':'UTF-8'}">{l s='Previous' d='Modules.Pixelaudit.Admin'}</a>{/if} {if $audit_page * $audit_page_size < $audit_result.count}<a class="btn btn-default" href="{$audit_next|escape:'html':'UTF-8'}">{l s='Next' d='Modules.Pixelaudit.Admin'}</a>{/if}</div></nav>
  {/if}
</div>
