<form method="get" action="{$audit_url|escape:'html':'UTF-8'}" class="pixel-audit-filter-grid">
  <input type="hidden" name="controller" value="AdminPixelAudit"><input type="hidden" name="token" value="{$audit_token|escape:'html':'UTF-8'}">
  <div class="pixel-audit-control"><label for="audit-family">{l s='Family' d='Modules.Pixelaudit.Admin'}</label><select class="form-control" id="audit-family" name="audit_family"><option value="">{l s='All families' d='Modules.Pixelaudit.Admin'}</option>{foreach $audit_families as $key => $label}<option value="{$key|escape:'html':'UTF-8'}" {if $audit_filters.family == $key}selected{/if}>{$label|escape:'html':'UTF-8'}</option>{/foreach}</select></div>
  <div class="pixel-audit-control"><label for="audit-type">{l s='Object type' d='Modules.Pixelaudit.Admin'}</label><select class="form-control" id="audit-type" name="audit_type"><option value="">{l s='All objects' d='Modules.Pixelaudit.Admin'}</option>{foreach $audit_types as $type => $label}<option value="{$type|escape:'html':'UTF-8'}" {if $audit_filters.type == $type}selected{/if}>{l s=$label d='Modules.Pixelaudit.Admin'}</option>{/foreach}{if $audit_filters.type && !isset($audit_types[$audit_filters.type])}<option value="{$audit_filters.type|escape:'html':'UTF-8'}" selected>{$audit_filters.type|escape:'html':'UTF-8'}</option>{/if}</select></div>
  <div class="pixel-audit-control"><label for="audit-object">{l s='Object ID' d='Modules.Pixelaudit.Admin'}</label><input class="form-control" id="audit-object" type="number" min="1" name="audit_object" value="{$audit_filters.object|escape:'html':'UTF-8'}"></div>
  <div class="pixel-audit-control"><label for="audit-employee">{l s='Employee ID' d='Modules.Pixelaudit.Admin'}</label><input class="form-control" id="audit-employee" type="number" min="1" name="audit_employee" value="{$audit_filters.employee|escape:'html':'UTF-8'}"></div>
  <div class="pixel-audit-control"><label for="audit-action">{l s='Action' d='Modules.Pixelaudit.Admin'}</label><select class="form-control" id="audit-action" name="audit_action"><option value="">{l s='All actions' d='Modules.Pixelaudit.Admin'}</option>{foreach $audit_actions as $action => $actionLabel}<option value="{$action|escape:'html':'UTF-8'}" {if $audit_filters.action == $action}selected{/if}>{l s=$actionLabel d='Modules.Pixelaudit.Admin'}</option>{/foreach}</select></div>
  <div class="pixel-audit-control"><label for="audit-from">{l s='From' d='Modules.Pixelaudit.Admin'}</label><input class="form-control" id="audit-from" type="date" name="audit_from" value="{$audit_filters.from|escape:'html':'UTF-8'}"></div>
  <div class="pixel-audit-control"><label for="audit-to">{l s='To' d='Modules.Pixelaudit.Admin'}</label><input class="form-control" id="audit-to" type="date" name="audit_to" value="{$audit_filters.to|escape:'html':'UTF-8'}"></div>
  <div class="pixel-audit-control"><label for="audit-page-size">{l s='Rows per page' d='Modules.Pixelaudit.Admin'}</label><select class="form-control" id="audit-page-size" name="audit_page_size">{foreach [20, 50, 100, 200] as $size}<option value="{$size|intval}" {if $audit_page_size == $size}selected{/if}>{$size|intval}</option>{/foreach}</select></div>
  <div class="pixel-audit-filter-actions"><button class="btn btn-primary" type="submit"><i class="material-icons" aria-hidden="true">search</i>{l s='Filter' d='Modules.Pixelaudit.Admin'}</button><a class="btn btn-default" href="{$audit_url|escape:'html':'UTF-8'}">{l s='Reset filters' d='Modules.Pixelaudit.Admin'}</a></div>
</form>
