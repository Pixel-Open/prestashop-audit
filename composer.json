  "type": "prestashop-module",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-mbstring": "*"
  },
  "autoload": {
    "psr-4": {
      "Pixel\\Module\\Audit\\": "src/"
    }
  },
  "config": {
    "prepend-autoloader": false
  }
}
